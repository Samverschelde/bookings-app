<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="MailApp">
  <Id>b2c4e6a8-d1f3-4e5a-8b7c-9d2e4f6a8b0c</Id>
  <Version>1.0.0.5</Version>
  <ProviderName>Alert Opleidingen</ProviderName>
  <DefaultLocale>nl-BE</DefaultLocale>
  <DisplayName DefaultValue="Bookings Assistent"/>
  <Description DefaultValue="Maak een boeking vanuit deze e-mail"/>
  <IconUrl DefaultValue="https://wonderful-rock-0283f0310.7.azurestaticapps.net/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://wonderful-rock-0283f0310.7.azurestaticapps.net/icon-80.png"/>
  <SupportUrl DefaultValue="https://wonderful-rock-0283f0310.7.azurestaticapps.net"/>
  <AppDomains>
    <AppDomain>https://wonderful-rock-0283f0310.7.azurestaticapps.net</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://wonderful-rock-0283f0310.7.azurestaticapps.net/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
</OfficeApp>
